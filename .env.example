# Long random string used to sign the login cookie (e.g. `openssl rand -hex 32`).
SESSION_SECRET=change-me-to-a-long-random-string

# ---- Username accounts ----
# Invite code people enter to sign up. Leave unset to close sign-up.
SIGNUP_CODE=
# Account database: connect an Upstash Redis database in Vercel's Storage tab, which sets these two.
KV_REST_API_URL=
KV_REST_API_TOKEN=
# Password reset emails, sent with Resend (resend.com). MAIL_FROM must be an address on a domain verified there.
RESEND_API_KEY=
MAIL_FROM=
# Local testing only: AUTH_STORE=memory keeps accounts in memory, RESEND_API_KEY=console prints reset links.

# ---- Older sign-ins, still accepted ----
# Family emails that may sign in with APP_PASSWORD (type the email in the Username box).
ALLOWED_EMAILS=you@example.com,partner@example.com
# The family password everyone on the list signs in with.
APP_PASSWORD=change-me
# Optional: password for the guest user "Test", who chooses their own rider. Leave unset to turn the Test user off.
TEST_USER_PASSWORD=
