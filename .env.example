# Who may sign in: comma-separated email addresses.
ALLOWED_EMAILS=you@example.com,partner@example.com
# The family password everyone on the list signs in with.
APP_PASSWORD=change-me
# Long random string used to sign the login cookie (e.g. `openssl rand -hex 32`).
SESSION_SECRET=change-me-to-a-long-random-string
# Optional: password for the guest user "Test", who chooses their own rider. Leave unset to turn the Test user off.
TEST_USER_PASSWORD=
